{
  "name": "cypress-e2e-tests",
  "version": "1.0.0",
  "description": "Cypress, a JavaScript based automation testing tool designed for modern web applications.",
  "keywords": [
    "js",
    "functional",
    "regression",
    "unit",
    "load",
    "stress",
    "testing"
  ],
  "license": "ISC",
  "author": "Chaker Ben Said - QA Software Tester",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test:swaglabs": "cypress run --browser chrome --spec \"cypress/e2e/SwagLabs/**/*.cy.js\"",
    "test:swaglabs:cloud": "cypress run --record --key 97487063-2e65-4977-bce4-3f0364edbae6 --spec \"cypress/e2e/SwagLabs/**/*.cy.js\"",
    "test:swaglabs:cloud:parallel": "cypress run --record --key 97487063-2e65-4977-bce4-3f0364edbae6 --spec \"cypress/e2e/SwagLabs/**/*.cy.js\""
  },
  "devDependencies": {
    "allure-cypress": "^3.15.0",
    "cypress": "^16.3.0",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "playwright-webkit": "^1.65.1"
  },
  "allowScripts": {
    "cypress@16.3.0": true
  }
}
