              "context": null,
              "code": "// Vérifier que la page de l'inventaire est affichée.\ncy.get('[data-test=\"title\"]').should('be.visible').and('have.text', 'Products');\n// Vérifier qu'il y a six produits et comparer leurs prix au catalogue attendu.\ncy.get('.inventory_item').should('have.length', 6).each($product => {\n  // Lire le nom visible du produit pour sélectionner son prix attendu.\n  cy.wrap($product).find('.inventory_item_name').invoke('text').then(name => {\n    // Nettoyer les espaces autour du nom du produit.\n    const productName = name.trim();\n    // Vérifier que le nom du produit affiché correspond exactement au nom attendu.\n    expect(expectedPrices, `prix attendu pour ${productName}`).to.have.property(productName);\n    // Vérifier que le prix affiché correspond exactement au prix attendu.\n    cy.wrap($product).find('.inventory_item_price').should('be.visible').and('have.text', expectedPrices[productName]);\n  });\n});",
