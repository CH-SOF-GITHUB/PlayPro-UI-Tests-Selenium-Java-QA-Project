              "context": null,
              "code": "// Charger les données officielles de produits depuis la fixture JSON.\ncy.fixture('swaglabs_products').then(products => {\n  // Vérifier qu'exactement six produits sont affichés puis comparer chaque ligne par index.\n  cy.get('.inventory_item').should('have.length', 6).each(($item, index) => {\n    // Vérifier que le nom du produit correspond à la fixture au même index.\n    cy.wrap($item).find('.inventory_item_name').should('be.visible').and('have.text', products[index].name);\n    // Vérifier que la description du produit correspond à la fixture au même index.\n    cy.wrap($item).find('.inventory_item_desc').should('be.visible').and('have.text', products[index].description);\n    // Vérifier que le prix du produit correspond à la fixture au même index.\n    cy.wrap($item).find('.inventory_item_price').should('be.visible').and('have.text', products[index].price);\n  });\n});",
